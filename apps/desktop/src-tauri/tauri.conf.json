{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "promteSaver",
  "version": "0.9.0",
  "identifier": "app.promtesaver.local",
  "build": {
    "frontendDist": "../boot"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; style-src 'self'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/promtesaver-runtime"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "category": "Productivity",
    "shortDescription": "Your private local prompt library",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
