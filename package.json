{
  "name": "promtesaver",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.16.0 <25" },
  "scripts": {
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run contracts:check && npm run typecheck && npm test",
    "demo": "node apps/harness/replay.ts",
    "test:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File scripts/windows-accessibility-proof.ps1"
  },
  "dependencies": { "ajv": "8.20.0" },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "7.0.2" }
}
